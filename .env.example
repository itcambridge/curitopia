# Project URL from the Connect dialog, with no path. Placeholder only.
# Use https://your-project-ref.supabase.co rather than a URL ending in /rest/v1/.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key from the Connect dialog. Safe to expose because row-level security rejects unowned rows.
# Do not put a service-role key in this file or in any NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
