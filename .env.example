# Project URL from the Connect dialog, with no path. Placeholder only.
# Use https://your-project-ref.supabase.co rather than a URL ending in /rest/v1/.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key from the Connect dialog. Safe to expose because row-level security rejects unowned rows.
# Do not put a service-role key in this file or in any NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only secret for completed-session reflection. Never use a NEXT_PUBLIC_ name.
OPENAI_API_KEY=

# Optional API model id. A missing or blank value uses gpt-6-astra, the starting model in OpenAI's model guide:
# https://developers.openai.com/api/docs/models
# Use the id, for example gpt-6-luna. A display name such as "GPT-6 Luna" is rejected.
OPENAI_MODEL=gpt-6-astra

# Optional image model id for Focus Image. A missing or blank value uses gpt-image-2.5-flare.
# This is separate from OPENAI_MODEL. The Image API guide recommends Flare for everyday generation:
# https://developers.openai.com/api/docs/guides/image-generation
# Use the API id. A display name is rejected by the API.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
